{
  "name": "stick-it-up",
  "version": "0.1.0",
  "description": "Premium vector, holographic & chrome aesthetic sticker components for React",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "keywords": [
    "react",
    "stickers",
    "sticker-pack",
    "stick-it-up",
    "svg",
    "chrome",
    "metallic",
    "retro",
    "icons",
    "nextjs",
    "components"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
