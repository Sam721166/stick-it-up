{
  "name": "components",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:package && next build",
    "build:package": "npm --workspace=stick-it-up run build",
    "build:cf": "npm run build:package && opennextjs-cloudflare build",
    "preview:cf": "npm run build:package && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "npm run build:package && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@neondatabase/serverless": "^1.2.0",
    "@opennextjs/cloudflare": "^1.20.16",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.66.0",
    "next": "^16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "shaders": "^4.0.6",
    "stick-it-up": "^0.1.0",
    "wrangler": "^4.160.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "tsup": "^9.0.0",
    "typescript": "^5"
  }
}
